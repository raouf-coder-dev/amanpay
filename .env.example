# ── متغيّرات بيئة AmanPay ──────────────────────────────────────────────
# انسخ هذا الملف إلى .env محلياً، أو اضبط هذه المتغيّرات في بيئة الإنتاج.
# لا تضع قيماً حقيقية في .env.example (هذا للتوثيق فقط).

# False في الإنتاج، True للتطوير المحلي
DJANGO_DEBUG=False

# مفتاح سرّي عشوائي طويل — ولّده بـ:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=<ضع_مفتاحاً_عشوائياً_طويلاً_هنا>

# (اختياري) رابط قاعدة البيانات — الافتراضي sqlite محلياً
# DATABASE_URL=sqlite:///db.sqlite3
